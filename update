PCLdoc="$(/usr/bin/cat <<UPCL
Patch ${upgradePatchVerno} Changelog:
- Dovecot 2.4 configuration overhaul (required for Arch dovecot ≥ 2.4)
- Refresh all /etc/dovecot templates from conf/lib/vmail/dovecot
- Re-apply nameURI and SQL password substitutions
- Preserve existing SSL cert configuration when present
UPCL
)"
/usr/bin/echo "$PCLdoc"
## So we can call a specific version later if needed
