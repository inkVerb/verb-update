## Loop existing zone files and add BIMI statements (skip if already present)
bimi_one() {
  local zonefile="$1"
  local domain="$2"
  local verberny="$3"
  [ -f "${zonefile}" ] || return 0
  if /usr/bin/grep -Fq "; BIMI ${domain}" "${zonefile}" || /usr/bin/grep -Fq "default._bimi" "${zonefile}"; then
    return 0
  fi
  if [ ! -f "/srv/www/html/${domain}/bimi.svg" ] && [ -f "/opt/verb/conf/lib/logo/nib-logo.svg" ]; then
